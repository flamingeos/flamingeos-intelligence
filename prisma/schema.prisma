generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH (NextAuth v5)
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  channels      YoutubeChannel[]
  competitors   Competitor[]
  notifications Notification[]
  agentRuns     AgentRun[]
  knowledgeBase KnowledgeBase[]
  trendReports  TrendReport[]
  scriptReports ScriptReport[]
  titleReports  TitleReport[]
  thumbnailReports ThumbnailReport[]
  contentCalendar  ContentCalendar[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// YOUTUBE CHANNEL (your own channel)
// ============================================================

model YoutubeChannel {
  id              String   @id @default(cuid())
  userId          String
  channelId       String   @unique
  handle          String?
  title           String
  description     String?  @db.Text
  thumbnailUrl    String?
  customUrl       String?
  country         String?
  subscriberCount BigInt   @default(0)
  viewCount       BigInt   @default(0)
  videoCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastSynced      DateTime?

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos         Video[]
  dailySnapshots DailySnapshot[]

  @@index([userId])
}

// ============================================================
// YOUR VIDEOS
// ============================================================

model Video {
  id                   String   @id @default(cuid())
  channelId            String
  videoId              String   @unique
  title                String
  description          String?  @db.Text
  thumbnailUrl         String?
  publishedAt          DateTime
  duration             String?
  viewCount            BigInt   @default(0)
  likeCount            BigInt   @default(0)
  commentCount         BigInt   @default(0)
  favoriteCount        BigInt   @default(0)
  averageViewDuration  Int?
  averageViewPercentage Float?
  ctr                  Float?
  impressions          BigInt   @default(0)
  watchTimeMinutes     Float?
  estimatedRevenue     Float?
  estimatedRpm         Float?
  estimatedCpm         Float?
  tags                 String[]
  categoryId           String?
  status               String   @default("published")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  channel YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  metrics VideoMetric[]

  @@index([channelId, publishedAt])
}

model VideoMetric {
  id                   String   @id @default(cuid())
  videoId              String
  date                 DateTime @db.Date
  viewCount            BigInt   @default(0)
  likeCount            BigInt   @default(0)
  commentCount         BigInt   @default(0)
  watchTimeMinutes     Float?
  averageViewDuration  Int?
  averageViewPercentage Float?
  ctr                  Float?
  impressions          BigInt   @default(0)
  estimatedRevenue     Float?
  estimatedRpm         Float?
  subscribersGained    Int      @default(0)
  subscribersLost      Int      @default(0)
  createdAt            DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, date])
  @@index([videoId, date])
}

// ============================================================
// DAILY CHANNEL SNAPSHOTS
// ============================================================

model DailySnapshot {
  id                   String   @id @default(cuid())
  channelId            String
  date                 DateTime @db.Date
  subscriberCount      BigInt
  viewCount            BigInt
  videoCount           Int
  watchTimeMinutes     Float?
  estimatedRevenue     Float?
  estimatedRpm         Float?
  averageCtr           Float?
  subscribersGained    Int      @default(0)
  subscribersLost      Int      @default(0)
  newViewers           Int?
  returningViewers     Int?
  createdAt            DateTime @default(now())

  channel YoutubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, date])
  @@index([channelId, date])
}

// ============================================================
// COMPETITORS
// ============================================================

model Competitor {
  id              String    @id @default(cuid())
  userId          String
  channelId       String
  handle          String?
  title           String
  description     String?   @db.Text
  thumbnailUrl    String?
  customUrl       String?
  country         String?
  subscriberCount BigInt    @default(0)
  viewCount       BigInt    @default(0)
  videoCount      Int       @default(0)
  uploadFrequency Float?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastChecked     DateTime?

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos    CompetitorVideo[]
  analyses  CompetitorAnalysis[]

  @@unique([userId, channelId])
  @@index([userId])
}

model CompetitorVideo {
  id               String    @id @default(cuid())
  competitorId     String
  videoId          String    @unique
  title            String
  description      String?   @db.Text
  thumbnailUrl     String?
  publishedAt      DateTime
  viewCount        BigInt    @default(0)
  likeCount        BigInt    @default(0)
  commentCount     BigInt    @default(0)
  duration         String?
  tags             String[]
  viewVelocity     Float?
  viewsPerDay      Float?

  aiSummary        String?   @db.Text
  whyItPerforms    String?   @db.Text
  opportunityForUs String?   @db.Text
  titleVariations  String[]
  confidenceScore  Float?
  analyzed         Boolean   @default(false)
  analyzedAt       DateTime?

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([competitorId, publishedAt])
}

model CompetitorAnalysis {
  id               String   @id @default(cuid())
  competitorId     String
  analysisType     String
  period           String?
  topicsAnalysis   Json?
  titlePatterns    Json?
  thumbnailPatterns Json?
  uploadFrequency  Float?
  avgViews         Float?
  growthRate       Float?
  subscriberDelta  BigInt   @default(0)
  recommendations  Json?
  confidenceScore  Float?
  rawData          Json?
  createdAt        DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([competitorId, createdAt])
}

// ============================================================
// TREND REPORTS
// ============================================================

model TrendReport {
  id                String   @id @default(cuid())
  userId            String
  topic             String
  source            String
  summary           String?  @db.Text
  velocityScore     Float?
  competitionScore  Float?
  opportunityScore  Float?
  relevanceScore    Float?
  overallScore      Float?

  researchReport    String?  @db.Text
  topicBreakdown    Json?
  historicalContext String?  @db.Text
  audienceInterest  Json?
  relatedTopics     String[]
  viralAngles       String[]
  contrarianAngles  String[]

  rawData           Json?
  status            String   @default("pending")
  alertSent         Boolean  @default(false)
  aiModel           String?
  tokensUsed        Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, overallScore])
}

// ============================================================
// SCRIPT REPORTS
// ============================================================

model ScriptReport {
  id                String   @id @default(cuid())
  userId            String
  title             String
  topic             String?
  scriptType        String
  style             String?
  targetDuration    Int?

  hook              String?  @db.Text
  intro             String?  @db.Text
  body              String?  @db.Text
  fullScript        String   @db.Text
  openLoops         String[]
  retentionPoints   String[]
  ctaPlacements     Json?
  outro             String?  @db.Text

  estimatedDuration Int?
  wordCount         Int?
  confidenceScore   Float?
  aiModel           String?
  tokensUsed        Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============================================================
// TITLE REPORTS
// ============================================================

model TitleReport {
  id             String   @id @default(cuid())
  userId         String
  topic          String
  targetKeywords String[]
  titles         Json
  topTitle       String?
  confidenceScore Float?
  aiModel        String?
  tokensUsed     Int?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============================================================
// THUMBNAIL REPORTS
// ============================================================

model ThumbnailReport {
  id             String   @id @default(cuid())
  userId         String
  topic          String
  videoTitle     String?
  concepts       Json
  topConceptIdx  Int?
  confidenceScore Float?
  aiModel        String?
  tokensUsed     Int?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============================================================
// CONTENT CALENDAR
// ============================================================

model ContentCalendar {
  id             String   @id @default(cuid())
  userId         String
  scheduledDate  DateTime
  title          String
  topic          String?
  scriptType     String?
  status         String   @default("planned")
  priority       Int      @default(1)
  notes          String?  @db.Text
  trendReportId  String?
  scriptReportId String?
  titleReportId  String?
  thumbnailReportId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledDate])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  body        String   @db.Text
  data        Json?
  read        Boolean  @default(false)
  emailSent   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

// ============================================================
// AGENT RUNS
// ============================================================

model AgentRun {
  id             String    @id @default(cuid())
  userId         String
  agentType      String
  status         String    @default("running")
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  inputs         Json?
  outputs        Json?
  reasoning      String?   @db.Text
  confidenceScore Float?
  error          String?   @db.Text
  tokensUsed     Int?
  durationMs     Int?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, agentType, startedAt])
}

// ============================================================
// KNOWLEDGE BASE (semantic search)
// ============================================================

model KnowledgeBase {
  id             String   @id @default(cuid())
  userId         String
  type           String
  title          String
  content        String   @db.Text
  tags           String[]
  sourceType     String?
  sourceId       String?
  confidenceScore Float?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}
